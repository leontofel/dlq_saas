<section class="space-y-6">
  <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">Project overview</p>
    <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-stone-950"><%= @project.name %></h1>
        <p class="mt-2 text-sm leading-7 text-stone-600">
          <%= @project.organization.name %> · <code><%= @project.slug %></code> ·
          <%= @project.environment %> · <%= @project.status %>
        </p>
      </div>
      <%= link_to "Back to projects", organization_projects_path(@project.organization),
                  class: "rounded-xl border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition hover:border-stone-400 hover:text-stone-950" %>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
        <p class="text-sm text-stone-500">Retention</p>
        <p class="mt-2 text-lg font-semibold text-stone-950"><%= @project.default_retention_days %> days</p>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
        <p class="text-sm text-stone-500">Payload cap</p>
        <p class="mt-2 text-lg font-semibold text-stone-950"><%= number_with_delimiter(@project.max_payload_size_bytes) %> bytes</p>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
        <p class="text-sm text-stone-500">Replay policy</p>
        <p class="mt-2 text-lg font-semibold text-stone-950"><%= @project.default_replay_policy %></p>
      </div>
    </div>
  </div>

  <% if flash[:new_api_key_secret].present? && current_membership.at_least?(:admin) %>
    <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 shadow-sm">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-amber-700">Copy once</p>
      <h2 class="mt-2 text-xl font-semibold text-amber-950">New API key secret</h2>
      <p class="mt-2 text-sm leading-7 text-amber-900">
        This raw key will not be shown again after this page render.
      </p>
      <pre class="mt-4 overflow-x-auto rounded-2xl bg-stone-950 px-4 py-4 text-sm text-stone-100"><%= flash.delete(:new_api_key_secret) %></pre>
    </div>
  <% end %>

  <div class="grid gap-6 xl:grid-cols-[1fr_0.85fr]">
    <% if current_membership.at_least?(:admin) %>
      <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">API keys</p>
          <h2 class="mt-2 text-xl font-semibold text-stone-950">Ingestion credentials</h2>
        </div>
        <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-stone-700"><%= @project_api_keys.size %> total</span>
      </div>

      <% if @project_api_keys.any? %>
        <div class="mt-5 overflow-hidden rounded-2xl border border-stone-200">
          <table class="min-w-full divide-y divide-stone-200 text-sm">
            <thead class="bg-stone-50 text-left text-stone-500">
              <tr>
                <th class="px-4 py-3 font-medium">Name</th>
                <th class="px-4 py-3 font-medium">Prefix</th>
                <th class="px-4 py-3 font-medium">Scopes</th>
                <th class="px-4 py-3 font-medium">Status</th>
                <th class="px-4 py-3 font-medium"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-200 bg-white">
              <% @project_api_keys.each do |project_api_key| %>
                <tr>
                  <td class="px-4 py-3 font-medium text-stone-900"><%= project_api_key.name %></td>
                  <td class="px-4 py-3 text-stone-600"><%= project_api_key.key_prefix %></td>
                  <td class="px-4 py-3 text-stone-600"><%= project_api_key.scopes.join(", ") %></td>
                  <td class="px-4 py-3 text-stone-600"><%= project_api_key.revoked? ? "revoked" : "active" %></td>
                  <td class="px-4 py-3 text-right">
                    <% unless project_api_key.revoked? %>
                      <%= button_to "Revoke", revoke_project_project_api_key_path(@project, project_api_key),
                                    method: :patch,
                                    class: "rounded-xl border border-rose-300 px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-rose-700 transition hover:border-rose-400 hover:text-rose-900" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="mt-5 rounded-2xl border border-dashed border-stone-300 bg-stone-50 px-5 py-6 text-sm text-stone-600">
          No API keys yet. Create one to open the ingestion endpoint for this project.
        </p>
      <% end %>
      </div>
    <% end %>

    <div class="space-y-6">
      <% if current_membership.at_least?(:admin) %>
        <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-stone-950">Create API key</h2>
        <p class="mt-2 text-sm leading-7 text-stone-600">
          Only the digest is stored. The raw secret is revealed once after creation.
        </p>

        <%= form_with url: project_project_api_keys_path(@project), scope: :project_api_key, class: "mt-5 space-y-4" do |form| %>
          <div>
            <%= form.label :name, class: "block text-sm font-medium text-stone-700" %>
            <%= form.text_field :name, required: true, value: params.dig(:project_api_key, :name),
                                class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
          </div>

          <div>
            <p class="block text-sm font-medium text-stone-700">Scopes</p>
            <label class="mt-3 flex items-center gap-3 rounded-2xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-700">
              <%= check_box_tag "project_api_key[scopes][]", "messages:write",
                                Array(params.dig(:project_api_key, :scopes)).exclude?("").presence || true,
                                class: "h-4 w-4 rounded border-stone-300 text-stone-900 focus:ring-stone-900" %>
              <span><code>messages:write</code> for failed-message ingestion</span>
            </label>
          </div>

          <%= form.submit "Create API key",
                          class: "rounded-2xl bg-stone-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-stone-800" %>
        <% end %>
        </div>
      <% end %>

      <div class="rounded-3xl border border-stone-200 bg-stone-900 p-6 text-stone-100 shadow-sm">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-400">Sprint 2 surfaces</p>
        <div class="mt-4 space-y-3 text-sm">
          <%= link_to "Open inbox", project_failed_messages_path(@project), class: "block rounded-2xl border border-stone-700 px-4 py-3 text-stone-100 transition hover:border-stone-500" %>
          <% if current_membership.at_least?(:admin) %>
            <%= link_to "Manage sources", project_sources_path(@project), class: "block rounded-2xl border border-stone-700 px-4 py-3 text-stone-100 transition hover:border-stone-500" %>
            <%= link_to "Manage redaction rules", project_redaction_rules_path(@project), class: "block rounded-2xl border border-stone-700 px-4 py-3 text-stone-100 transition hover:border-stone-500" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
