<section class="space-y-6">
  <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">Sources</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-stone-950">Project sources</h1>
        <p class="mt-2 text-sm leading-7 text-stone-600">
          Define which producers are allowed to write failed messages into <%= @project.name %>.
        </p>
      </div>
      <%= link_to "Open inbox", project_failed_messages_path(@project),
                  class: "rounded-xl border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition hover:border-stone-400 hover:text-stone-950" %>
    </div>
  </div>

  <div class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
    <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">Configured sources</p>
          <h2 class="mt-2 text-xl font-semibold text-stone-950">Current source list</h2>
        </div>
        <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-stone-700"><%= @sources.size %> total</span>
      </div>

      <% if @sources.any? %>
        <div class="mt-5 overflow-hidden rounded-2xl border border-stone-200">
          <table class="min-w-full divide-y divide-stone-200 text-sm">
            <thead class="bg-stone-50 text-left text-stone-500">
              <tr>
                <th class="px-4 py-3 font-medium">Name</th>
                <th class="px-4 py-3 font-medium">Slug</th>
                <th class="px-4 py-3 font-medium">Environment</th>
                <th class="px-4 py-3 font-medium">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-200 bg-white">
              <% @sources.each do |source| %>
                <tr>
                  <td class="px-4 py-3 font-medium text-stone-900"><%= source.name %></td>
                  <td class="px-4 py-3 text-stone-600"><code><%= source.slug %></code></td>
                  <td class="px-4 py-3 text-stone-600"><%= source.environment.presence || "any" %></td>
                  <td class="px-4 py-3 text-stone-600"><%= source.status %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="mt-5 rounded-2xl border border-dashed border-stone-300 bg-stone-50 px-5 py-6 text-sm text-stone-600">
          No sources yet. Add one before testing the ingestion endpoint.
        </p>
      <% end %>
    </div>

    <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-950">Add source</h2>
      <p class="mt-2 text-sm leading-7 text-stone-600">
        Keep it simple: one source slug per producer.
      </p>

      <%= form_with url: project_sources_path(@project), scope: :source, class: "mt-5 space-y-4" do |form| %>
        <div>
          <%= form.label :name, class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field :name, required: true, value: @source.name,
                              class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
        </div>

        <div>
          <%= form.label :slug, class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field :slug, required: true, value: @source.slug,
                              class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :environment, class: "block text-sm font-medium text-stone-700" %>
            <%= form.text_field :environment, value: @source.environment,
                                class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
          </div>

          <div>
            <%= form.label :status, class: "block text-sm font-medium text-stone-700" %>
            <%= form.select :status, Source::STATUSES.map { |status| [status.titleize, status] }, { selected: @source.status || "active" },
                            class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
          </div>
        </div>

        <div>
          <%= form.label :description, class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_area :description, rows: 4, value: @source.description,
                             class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
        </div>

        <%= form.hidden_field :source_type, value: "http" %>

        <%= form.submit "Create source",
                        class: "rounded-2xl bg-stone-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-stone-800" %>
      <% end %>
    </div>
  </div>
</section>
