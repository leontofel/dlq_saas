<section class="grid gap-6 lg:grid-cols-[1.3fr_0.7fr]">
  <div class="space-y-6">
    <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">Overview</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-stone-950">Foundation sprint control room</h1>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-stone-600">
        This shell is intentionally narrow for Sprint 1: authenticated access, tenant boundaries,
        project setup, and API keys. The inbox, incidents, and replay surfaces can layer onto this
        once the foundation is stable.
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
          <p class="text-sm text-stone-500">Organizations</p>
          <p class="mt-2 text-3xl font-semibold text-stone-950"><%= @organizations.size %></p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
          <p class="text-sm text-stone-500">Recent projects</p>
          <p class="mt-2 text-3xl font-semibold text-stone-950"><%= @recent_projects.size %></p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
          <p class="text-sm text-stone-500">Signed in as</p>
          <p class="mt-2 text-lg font-semibold text-stone-950"><%= current_user.name %></p>
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">Organizations</p>
          <h2 class="mt-2 text-xl font-semibold text-stone-950">Your tenant boundaries</h2>
        </div>
        <%= link_to "Manage organizations", organizations_path,
                    class: "rounded-xl border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition hover:border-stone-400 hover:text-stone-950" %>
      </div>

      <% if @organizations.any? %>
        <div class="mt-5 grid gap-4">
          <% @organizations.each do |organization| %>
            <%= link_to organization_path(organization),
                        class: "block rounded-2xl border border-stone-200 bg-stone-50 px-5 py-4 transition hover:border-stone-300 hover:bg-white" do %>
              <div class="flex items-center justify-between gap-4">
                <div>
                  <h3 class="text-base font-semibold text-stone-950"><%= organization.name %></h3>
                  <p class="mt-1 text-sm text-stone-500"><%= organization.projects.size %> project(s)</p>
                </div>
                <span class="rounded-full bg-stone-200 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-stone-700"><%= current_user.role_for(organization) %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-5 rounded-2xl border border-dashed border-stone-300 bg-stone-50 px-5 py-6 text-sm text-stone-600">
          No organizations yet. Create one to start defining projects and ingestion credentials.
        </p>
      <% end %>
    </div>
  </div>

  <aside class="space-y-6">
    <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">Projects</p>
      <h2 class="mt-2 text-xl font-semibold text-stone-950">Recent placeholders</h2>
      <% if @recent_projects.any? %>
        <div class="mt-5 space-y-3">
          <% @recent_projects.each do |project| %>
            <%= link_to project_path(project),
                        class: "block rounded-2xl border border-stone-200 px-4 py-3 transition hover:border-stone-300 hover:bg-stone-50" do %>
              <p class="font-medium text-stone-900"><%= project.name %></p>
              <p class="mt-1 text-sm text-stone-500"><%= project.organization.name %> · <%= project.environment %></p>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-5 text-sm leading-7 text-stone-600">
          The Projects area is ready for the next sprint, but there are no projects in scope yet.
        </p>
      <% end %>
    </div>

    <div class="rounded-3xl border border-stone-200 bg-stone-900 p-6 text-stone-100 shadow-sm">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-400">Next surfaces</p>
      <ul class="mt-4 space-y-3 text-sm leading-7 text-stone-200">
        <li>Failed message inbox and filters</li>
        <li>Incident grouping and operator notes</li>
        <li>Replay batches, approvals, and audit trails</li>
      </ul>
    </div>
  </aside>
</section>
