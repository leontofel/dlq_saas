<section class="space-y-6">
  <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">Overview</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-stone-950"><%= @organization.name %></h1>
        <p class="mt-2 text-sm leading-7 text-stone-600">
          Organization slug: <code><%= @organization.slug %></code>. Projects, API keys, and later
          message workflows all inherit this tenant boundary.
        </p>
      </div>
      <%= link_to "Open projects placeholder", organization_projects_path(@organization),
                  class: "rounded-xl border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition hover:border-stone-400 hover:text-stone-950" %>
    </div>
  </div>

  <div class="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
    <div class="space-y-6">
      <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">Projects</p>
            <h2 class="mt-2 text-xl font-semibold text-stone-950">Projects in this organization</h2>
          </div>
          <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-stone-700"><%= @projects.size %> total</span>
        </div>

        <% if @projects.any? %>
          <div class="mt-5 space-y-3">
            <% @projects.each do |project| %>
              <%= link_to project_path(project),
                          class: "block rounded-2xl border border-stone-200 bg-stone-50 px-5 py-4 transition hover:border-stone-300 hover:bg-white" do %>
                <div class="flex items-center justify-between gap-4">
                  <div>
                    <h3 class="text-base font-semibold text-stone-950"><%= project.name %></h3>
                    <p class="mt-1 text-sm text-stone-500"><%= project.environment %> · <%= project.status %></p>
                  </div>
                  <span class="text-sm text-stone-500"><%= project.slug %></span>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="mt-5 rounded-2xl border border-dashed border-stone-300 bg-stone-50 px-5 py-6 text-sm text-stone-600">
            No projects yet. Create the first one from the Projects placeholder page.
          </p>
        <% end %>
      </div>

      <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">Memberships</p>
        <h2 class="mt-2 text-xl font-semibold text-stone-950">Who can operate here</h2>

        <div class="mt-5 overflow-hidden rounded-2xl border border-stone-200">
          <table class="min-w-full divide-y divide-stone-200 text-sm">
            <thead class="bg-stone-50 text-left text-stone-500">
              <tr>
                <th class="px-4 py-3 font-medium">User</th>
                <th class="px-4 py-3 font-medium">Email</th>
                <th class="px-4 py-3 font-medium">Role</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-200 bg-white">
              <% @memberships.each do |membership| %>
                <tr>
                  <td class="px-4 py-3 font-medium text-stone-900"><%= membership.user_name %></td>
                  <td class="px-4 py-3 text-stone-600"><%= membership.user_email %></td>
                  <td class="px-4 py-3 text-stone-600"><%= membership.role %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-950">Add member</h2>
      <p class="mt-2 text-sm leading-7 text-stone-600">
        Add an existing account by email and assign one of the foundation roles.
      </p>

      <%= form_with url: organization_organization_memberships_path(@organization),
                    scope: :organization_membership,
                    class: "mt-5 space-y-4" do |form| %>
        <div>
          <%= form.label :email, "User email", class: "block text-sm font-medium text-stone-700" %>
          <%= form.email_field :email, required: true, value: params.dig(:organization_membership, :email),
                               class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
        </div>

        <div>
          <%= form.label :role, "Role", class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :role,
                          OrganizationMembership::ROLES.map { |role| [role.titleize, role] },
                          { selected: params.dig(:organization_membership, :role) || "viewer" },
                          class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
        </div>

        <%= form.submit "Add member",
                        class: "rounded-2xl bg-stone-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-stone-800" %>
      <% end %>
    </div>
  </div>
</section>
