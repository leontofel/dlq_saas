<% content_for :title, "Sign Up | DLQ Control Center" %>

<main class="auth-page auth-page--ink">
  <section class="auth-page__panel auth-page__panel--story">
    <p class="auth-kicker">DLQ Control Center</p>
    <h1 class="auth-title">Build the operator console before the incident hits.</h1>
    <p class="auth-copy">
      This first account opens the door to organization setup, project boundaries, and the rest
      of the recovery workflow. Start with a durable admin identity.
    </p>

    <div class="auth-rail">
      <div>
        <span>01</span>
        <p>Create the first user</p>
      </div>
      <div>
        <span>02</span>
        <p>Create an organization</p>
      </div>
      <div>
        <span>03</span>
        <p>Start shaping the failure inbox</p>
      </div>
    </div>
  </section>

  <section class="auth-page__panel auth-page__panel--form">
    <div class="auth-card">
      <div class="auth-card__header">
        <p class="auth-card__eyebrow">First access</p>
        <h2>Create your account</h2>
        <p>
          Use a strong password. After sign-up, you land directly in the dashboard and can create
          your first organization.
        </p>
      </div>

      <%= form_with url: signup_path,
                    scope: :sign_up,
                    class: "auth-form" do |form| %>
        <div class="auth-field">
          <%= form.label :name, "Full name" %>
          <%= form.text_field :name,
                              required: true,
                              autocomplete: "name",
                              placeholder: "Jordan Lee",
                              value: params.dig(:sign_up, :name) %>
        </div>

        <div class="auth-field">
          <%= form.label :email, "Email" %>
          <%= form.email_field :email,
                               required: true,
                               autocomplete: "email",
                               placeholder: "jordan@company.com",
                               value: params.dig(:sign_up, :email) %>
        </div>

        <div class="auth-field">
          <%= form.label :password, "Password" %>
          <%= form.password_field :password,
                                  required: true,
                                  minlength: 12,
                                  autocomplete: "new-password",
                                  placeholder: "Minimum 12 characters" %>
          <p class="auth-field__hint">Use at least 12 characters.</p>
        </div>

        <div class="auth-form__footer">
          <button type="submit" class="auth-button" data-auth-form-target="submitButton">
            Create Account
          </button>
          <p class="auth-switch">
            Already have access?
            <%= link_to "Log in", login_page_path %>
          </p>
        </div>

      <% end %>
    </div>
  </section>
</main>
