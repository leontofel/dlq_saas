<% content_for :title, "Log In | DLQ Control Center" %>

<main class="auth-page auth-page--ember">
  <section class="auth-page__panel auth-page__panel--story">
    <p class="auth-kicker">DLQ Control Center</p>
    <h1 class="auth-title">Failure recovery, with a steady hand.</h1>
    <p class="auth-copy">
      Inspect what broke, replay what matters, and keep the operational paper trail intact.
      This UI is the calm surface over a very noisy system.
    </p>

    <div class="auth-metrics">
      <div class="auth-metric">
        <span class="auth-metric__label">Mode</span>
        <strong>HTTP-first MVP</strong>
      </div>
      <div class="auth-metric">
        <span class="auth-metric__label">Promise</span>
        <strong>Safe replay over convenience</strong>
      </div>
      <div class="auth-metric">
        <span class="auth-metric__label">Audience</span>
        <strong>Developers, operators, platform teams</strong>
      </div>
    </div>
  </section>

  <section class="auth-page__panel auth-page__panel--form">
    <div class="auth-card">
      <div class="auth-card__header">
        <p class="auth-card__eyebrow">Welcome back</p>
        <h2>Log in</h2>
        <p>
          Use your account to get an access token for the current JWT-based auth flow.
        </p>
      </div>

      <% if params[:created].present? %>
        <div class="auth-banner auth-banner--success">
          Account created. You can log in now.
        </div>
      <% end %>

      <%= form_with url: login_path,
                    scope: :login,
                    class: "auth-form",
                    data: {
                      action: "submit->auth-form#submit",
                      controller: "auth-form",
                      auth_form_mode_value: "login",
                      auth_form_action_label_value: "Log In",
                      turbo: false
                    } do |form| %>
        <div class="auth-field">
          <%= form.label :email, "Email" %>
          <%= form.email_field :email,
                               required: true,
                               autocomplete: "email",
                               placeholder: "operator@company.com" %>
        </div>

        <div class="auth-field">
          <%= form.label :password, "Password" %>
          <%= form.password_field :password,
                                  required: true,
                                  autocomplete: "current-password",
                                  placeholder: "Your password" %>
        </div>

        <div class="auth-form__footer">
          <button type="submit" class="auth-button" data-auth-form-target="submitButton">
            Log In
          </button>
          <p class="auth-switch">
            Need an account?
            <%= link_to "Create one", signup_page_path %>
          </p>
        </div>

        <div class="auth-status" data-auth-form-target="status" hidden></div>

        <section class="auth-token" data-auth-form-target="tokenPanel" hidden>
          <div class="auth-token__header">
            <div>
              <p class="auth-token__eyebrow">JWT issued</p>
              <h3 data-auth-form-target="identity">Signed in</h3>
            </div>
            <button type="button"
                    class="auth-token__copy"
                    data-action="auth-form#copyToken"
                    data-auth-form-target="copyButton">
              Copy token
            </button>
          </div>

          <pre class="auth-token__value" data-auth-form-target="tokenValue"></pre>

          <p class="auth-token__hint">
            Store this as a Bearer token for protected API requests in the current backend flow.
          </p>
        </section>
      <% end %>
    </div>
  </section>
</main>
