<section class="space-y-6">
  <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-stone-500">Projects</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-stone-950"><%= @organization.name %> projects</h1>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-stone-600">
      This placeholder page establishes the main business boundary for failed messages, incident
      groups, replay destinations, and alert rules in later sprints.
    </p>
  </div>

  <div class="grid gap-6 xl:grid-cols-[1fr_0.85fr]">
    <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-950">Existing projects</h2>
      <% if @projects.any? %>
        <div class="mt-5 space-y-4">
          <% @projects.each do |project| %>
            <%= link_to project_path(project),
                        class: "block rounded-2xl border border-stone-200 bg-stone-50 px-5 py-4 transition hover:border-stone-300 hover:bg-white" do %>
              <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                  <h3 class="text-base font-semibold text-stone-950"><%= project.name %></h3>
                  <p class="mt-1 text-sm text-stone-500"><%= project.environment %> · <%= project.status %></p>
                </div>
                <div class="text-right text-sm text-stone-500">
                  <p><%= project.slug %></p>
                  <p class="mt-1"><%= project.default_retention_days %> day retention</p>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-5 rounded-2xl border border-dashed border-stone-300 bg-stone-50 px-5 py-6 text-sm text-stone-600">
          No projects exist yet for this organization.
        </p>
      <% end %>
    </div>

    <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-950">Create project</h2>
      <p class="mt-2 text-sm leading-7 text-stone-600">
        Set the initial status, environment, and default retention configuration now so later
        ingestion features have a safe home.
      </p>

      <%= form_with url: organization_projects_path(@organization), scope: :project, class: "mt-5 space-y-4" do |form| %>
        <div>
          <%= form.label :name, class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field :name, required: true, value: params.dig(:project, :name),
                              class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
        </div>

        <div>
          <%= form.label :slug, class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_field :slug, value: params.dig(:project, :slug),
                              class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :environment, class: "block text-sm font-medium text-stone-700" %>
            <%= form.select :environment,
                            Project::ENVIRONMENTS.map { |value| [value.titleize, value] },
                            { selected: params.dig(:project, :environment) || "production" },
                            class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
          </div>

          <div>
            <%= form.label :status, class: "block text-sm font-medium text-stone-700" %>
            <%= form.select :status,
                            Project::STATUSES.map { |value| [value.titleize, value] },
                            { selected: params.dig(:project, :status) || "active" },
                            class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :default_retention_days, class: "block text-sm font-medium text-stone-700" %>
            <%= form.number_field :default_retention_days, min: 1, value: params.dig(:project, :default_retention_days) || 30,
                                  class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
          </div>

          <div>
            <%= form.label :max_payload_size_bytes, class: "block text-sm font-medium text-stone-700" %>
            <%= form.number_field :max_payload_size_bytes, min: 1, value: params.dig(:project, :max_payload_size_bytes) || 262_144,
                                  class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
          </div>
        </div>

        <div>
          <%= form.label :default_replay_policy, class: "block text-sm font-medium text-stone-700" %>
          <%= form.select :default_replay_policy,
                          Project::REPLAY_POLICIES.map { |value| [value.titleize, value] },
                          { selected: params.dig(:project, :default_replay_policy) || "manual_allowed" },
                          class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900" %>
        </div>

        <div>
          <%= form.label :allowed_source_identifiers, "Allowed source identifiers", class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_area :allowed_source_identifiers, rows: 5, value: params.dig(:project, :allowed_source_identifiers),
                             class: "mt-2 w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm outline-none transition focus:border-stone-900",
                             placeholder: "orders-worker\nbilling-consumer" %>
          <p class="mt-2 text-xs text-stone-500">One identifier per line.</p>
        </div>

        <%= form.submit "Create project",
                        class: "rounded-2xl bg-stone-950 px-4 py-3 text-sm font-semibold text-white transition hover:bg-stone-800" %>
      <% end %>
    </div>
  </div>
</section>
